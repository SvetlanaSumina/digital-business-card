# Учётные данные PostgreSQL (используются в docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio

# Подключение приложения к PostgreSQL (должно совпадать со значениями выше)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

# HTTP-порт приложения
PORT=3000

# Выводить все SQL-запросы в консоль (удобно для проверки батчинга DataLoader)
PRISMA_QUERY_LOG=false

# Порт на хосте для приложения в Docker (docker compose up)
APP_PORT=3000
